  <xs:element name="TransportReceipt" type="TransportReceiptComplexType">
    <xs:annotation>
      <xs:documentation>
				Das Element Transport beschreibt das Root-Element einer
				Transportdatei.
			</xs:documentation>
    </xs:annotation>
    <xs:key name="UniqueKeyForRecords">
      <xs:annotation>
        <xs:documentation>Unique-Key fuer alle Records.</xs:documentation>
      </xs:annotation>
      <xs:selector xpath="n:Record">
        <xs:annotation>
          <xs:documentation>
						Der Selektor wählt alle Knoten aus, über die der Unique-Key gültig
						ist.
					</xs:documentation>
        </xs:annotation>
      </xs:selector>
      <xs:field xpath="@GuidRecord">
        <xs:annotation>
          <xs:documentation>
						Das Attribute das den eindeutigen Schlüssel des Knoten
						beschreibt.
					</xs:documentation>
        </xs:annotation>
      </xs:field>
    </xs:key>
  </xs:element>
  <xs:simpleType name="BooleanDataType">
    <xs:annotation>
      <xs:documentation>Der BooleanDataType beschreibt einen einfachen Boolean-Wert der true oder false annehmen kann.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:boolean" />
  </xs:simpleType>
  <xs:simpleType name="DateTimeDataType">
    <xs:annotation>
      <xs:documentation>Der DateTimeDataType beschreibt einen einfachen Datums-Wert.(Format:)</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:dateTime">
