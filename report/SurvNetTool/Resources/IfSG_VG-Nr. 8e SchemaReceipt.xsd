  <xs:complexType name="TransportReceiptComplexType">
    <xs:annotation>
      <xs:documentation>
				Das Element TransportReceipt beschreibt das Root-Element einer
				Quittungsdatei.
			</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:annotation>
        <xs:documentation>Eine Quittung kann mindestens ein Element Record enthalten.</xs:documentation>
      </xs:annotation>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Record" type="RecordComplexType">
        <xs:annotation>
          <xs:documentation>Ein Record bestettigt den Import eines Datensatzes.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attribute name="GuidTransport" type="GuidDataType" use="required">
      <xs:annotation>
        <xs:documentation>Guid des Transportes.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="CodeSiteSender" type="StringSiteDataType" use="required">
      <xs:annotation>
        <xs:documentation>Die CodeSite des Senders.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="CodeSiteReceiver" type="StringSiteDataType" use="required">
      <xs:annotation>
        <xs:documentation>Die CodeSite des Empfaengers.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="TransportNumber" type="xs:nonNegativeInteger" use="required">
      <xs:annotation>
        <xs:documentation>Die fortlaufende Nummer des Transportes.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="CreatedAt" type="DateTimeDataType" use="optional">
      <xs:annotation>
        <xs:documentation>Gibt an wann der Transport verarbeitet und die Quittung erstellt wurde.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType id="RecordComplexType" name="RecordComplexType">
    <xs:annotation>
      <xs:documentation>Ein Record beinhaltet eine zu transportierenden Datensatz.</xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="1" maxOccurs="1">
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Message" type="MessageComplexType">
        <xs:annotation>
          <xs:documentation>Eine Message über eventuelle Fehler beim Import..</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="GuidRecord" type="GuidDataType" use="required">
      <xs:annotation>
        <xs:documentation>Guid</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Status" type="BooleanDataType" use="required">
      <xs:annotation>
        <xs:documentation>Der Status des importierten Datensatzes.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="MessageComplexType">
    <xs:annotation>
      <xs:documentation>Beschreibt eine Meldung eines Datensatzes zu einem Transportvorgang.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="Code" type="MessageTypeDataType" use="required">
      <xs:annotation>
        <xs:documentation>
					Die Guid des Datensatzes, mit dem eine Aktion durchgeführt werden
					soll.
				</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Text" type="String255DataType" use="optional">
      <xs:annotation>
        <xs:documentation>
					Die Guid des Datensatzes, mit dem eine Aktion durchgeführt werden
					soll.
				</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
</xs:schema>