<?xml version="1.0" encoding="UTF-8"?>
<!--
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  INV_Fragebogen_Erw_FULL_template.xml  — REFERENCE DOCUMENT             │
  │                                                                          │
  │  !! This file is NOT a SurvNet transport file !!                         │
  │  It is a field-mapping reference used by SurvNetTool internally.         │
  │                                                                          │
  │  Source : INV_Fragebogen_Erw_FULL.docx                                   │
  │  Purpose: Maps every DOCX field label → SurvNet mail-merge token and    │
  │           the corresponding Transport XML location (Group/Field path).   │
  │                                                                          │
  │  For the valid SurvNet 3.0 transport XML see:                            │
  │    INV_Fragebogen_Erw_FULL_final.xml                                     │
  │  Validated against:                                                      │
  │    IfSG_VG-Nr. 8f SchemaSurvNet_3.0_FD2025.xsd                          │
  │    NS: http://www3.rki.de/ns/SurvNet/2025/01/Transport                  │
  └─────────────────────────────────────────────────────────────────────────┘
-->
<QuestionnaireTemplate
    source="INV_Fragebogen_Erw_FULL.docx"
    exportDatum="2026-03-24"
    version="1.0"
    schemaRef="IfSG_VG-Nr. 8f SchemaSurvNet_3.0_FD2025.xsd"
    transportNS="http://www3.rki.de/ns/SurvNet/2025/01/Transport">

  <!--
    Official Transport XML structure summary
    ========================================
    <Transport GuidTransport="{GUID}" CodeSiteSender="1.01." CodeSiteReceiver="1."
               TransportNumber="1" CreatedAt="YYYY-MM-DDTHH:mm:ss.000">

      <INV GuidRecord="{GUID}" VersionNo="1" Schema="11"
           CodeRecordOwner="1.01." CodeVersionEditor="1.01."
           Token="«Disease.Token»"
           ToTransportManual="false" ChangedAt="..." TransportRequestType="1"
           ReportingDate="..." ReportingCounty="11001001" CaseDefEpiManual="false">

        <Group Name="GroupName">
          <Field Name="FieldKey" Value="answer"/>
        </Group>
        <Addressee CodeSite="1.01." Implicit="true" Explicit="false"/>
        <Track GuidTrack="{GUID}" Action="1" TrackedAt="..." CodeSite="1.01."
               VersionNoSite="1" Software="SurvNetTool 1.0.0"/>
      </INV>

      <AddPers GuidRecord="{GUID}" VersionNo="1" Schema="11"
               CodeRecordOwner="1.01." CodeVersionEditor="1.01."
               ToTransportManual="false" ChangedAt="..." TransportRequestType="1"
               Salutation="0" Surname="«AddressPerson.Surname»"
               Forename="«AddressPerson.Forename»"
               DateOfBirth="«AddressPerson.DateOfBirth»T00:00:00.000"
               Sex="0" Street="«AddressPerson.Street»"
               ZipCode="«AddressPerson.ZipCode»" Place="«AddressPerson.Place»"
               PhoneNumber1="(free text)" CountryofBirthMYT="0">
        <Addressee CodeSite="1.01." Implicit="true" Explicit="false"/>
        <Track GuidTrack="{GUID}" Action="1" TrackedAt="..." CodeSite="1.01."
               VersionNoSite="1" Software="SurvNetTool 1.0.0"/>
      </AddPers>

    </Transport>
  -->

  <!-- ═══════════════════════════════════════════════════════════════════
       Section 1 — Angaben zur betroffenen Person
       DOCX mail-merge tokens map to <AddPers> attributes in Transport XML.
  ═══════════════════════════════════════════════════════════════════════ -->
  <Section name="Angaben zur betroffenen Person">

    <Field seq="Q01" label="Aktenzeichen"
           placeholder="«Disease.Token»"
           transportLocation="INV/@Token  and  INV/Group[@Name='AngabenZurPerson']/Field[@Name='Aktenzeichen']"
           note="Unique case reference token from SurvNet"/>

    <Field seq="Q02" label="Name (Nachname)"
           placeholder="«AddressPerson.Surname»"
           transportLocation="AddPers/@Surname"
           note=""/>

    <Field seq="Q03" label="Vorname"
           placeholder="«AddressPerson.Forename»"
           transportLocation="AddPers/@Forename"
           note=""/>

    <Field seq="Q04" label="Geburtsdatum"
           placeholder="«AddressPerson.DateOfBirth»"
           transportLocation="AddPers/@DateOfBirth  (format: YYYY-MM-DDTHH:mm:ss.000)"
           note="DOCX format DD.MM.YYYY → ISO 8601 conversion required"/>

    <Field seq="Q05" label="Adresse"
           placeholder="«AddressPerson.Street», «AddressPerson.ZipCode» «AddressPerson.Place»"
           transportLocation="AddPers/@Street + @ZipCode + @Place"
           note="Street, postal code and city stored as separate attributes"/>

    <Field seq="Q06" label="Telefonnummer"
           placeholder=""
           transportLocation="AddPers/@PhoneNumber1"
           note="Free-text entry, no mail-merge field in DOCX template"/>

    <Field seq="Q07" label="Beruf / Name und Anschrift Arbeitgeber"
           placeholder=""
           transportLocation="INV/Group[@Name='AngabenZurPerson']/Field[@Name='Beruf_Arbeitgeber']"
           note="Free-text entry; stored in INV questionnaire group"/>

  </Section>

  <!-- ═══════════════════════════════════════════════════════════════════
       Section 2 — Symptome und Verlauf der Erkrankung
       All fields stored in INV/Group[@Name='Symptome'] or 'Krankheitsverlauf'.
  ═══════════════════════════════════════════════════════════════════════ -->
  <Section name="Symptome und Verlauf der Erkrankung">

    <Field seq="Q08"  label="Hatten Sie aufgrund der Erkrankung Symptome?"
           placeholder="" transportLocation="INV/Group[@Name='Symptome']/Field[@Name='HatteSymptome']"
           note="Ja / Nein; if Ja: onset date"/>

    <Field seq="Q09"  label="Schnupfen"
           placeholder="" transportLocation="INV/Group[@Name='Symptome']/Field[@Name='Schnupfen']"
           note="Ja / Nein / Weiß ich nicht"/>

    <Field seq="Q10"  label="Husten"
           placeholder="" transportLocation="INV/Group[@Name='Symptome']/Field[@Name='Husten']"
           note="Ja / Nein / Weiß ich nicht"/>

    <Field seq="Q11"  label="Halsschmerzen"
           placeholder="" transportLocation="INV/Group[@Name='Symptome']/Field[@Name='Halsschmerzen']"
           note="Ja / Nein / Weiß ich nicht"/>

    <Field seq="Q12"  label="Atemnot"
           placeholder="" transportLocation="INV/Group[@Name='Symptome']/Field[@Name='Atemnot']"
           note="Ja / Nein / Weiß ich nicht"/>

    <Field seq="Q13"  label="Bindehautentzündung (Infektion des Auges)"
           placeholder="" transportLocation="INV/Group[@Name='Symptome']/Field[@Name='Bindehautentzuendung']"
           note="Ja / Nein / Weiß ich nicht"/>

    <Field seq="Q14"  label="Herzmuskelentzündung"
           placeholder="" transportLocation="INV/Group[@Name='Symptome']/Field[@Name='Herzmuskelentzuendung']"
           note="Ja / Nein / Weiß ich nicht; empty if not answered"/>

    <Field seq="Q15"  label="Erbrechen"
           placeholder="" transportLocation="INV/Group[@Name='Symptome']/Field[@Name='Erbrechen']  + Field[@Name='Erbrechen_Anzahl']"
           note="Ja (+ Anzahl) / Nein / Weiß ich nicht; count stored in separate Field"/>

    <Field seq="Q16"  label="Durchfall"
           placeholder="" transportLocation="INV/Group[@Name='Symptome']/Field[@Name='Durchfall']"
           note="Ja (+ Anzahl) / Nein / Weiß ich nicht"/>

    <Field seq="Q17"  label="Fieber (Temperatur > 38 °C)"
           placeholder="" transportLocation="INV/Group[@Name='Symptome']/Field[@Name='Fieber']  + Field[@Name='Fieber_Temperatur_Grad']"
           note="Ja (+ Temperatur °C) / Nein / Weiß ich nicht; temperature stored in separate Field"/>

    <Field seq="Q18"  label="Weitere Symptome (Freitext)"
           placeholder="" transportLocation="INV/Group[@Name='Symptome']/Field[@Name='Weitere_Symptome']"
           note="Free-text description"/>

    <Field seq="Q19"  label="Haben Sie einen Arzt aufgesucht?"
           placeholder="" transportLocation="INV/Group[@Name='Krankheitsverlauf']/Field[@Name='Arzt_aufgesucht']  + Field[@Name='Arzt_Name']"
           note="Ja (+ Name Arzt) / Nein"/>

    <Field seq="Q20"  label="Wurden Sie in einem Krankenhaus behandelt?"
           placeholder="" transportLocation="INV/Group[@Name='Krankheitsverlauf']/Field[@Name='Krankenhaus_behandelt']  + Field[@Name='Krankenhaus_Name']"
           note="Ja (+ Krankenhaus + Dauer) / Nein"/>

    <Field seq="Q21"  label="Wurde eine Lungenentzündung (Pneumonie) diagnostiziert?"
           placeholder="" transportLocation="INV/Group[@Name='Krankheitsverlauf']/Field[@Name='Pneumonie_diagnostiziert']"
           note="Ja / Nein / Weiss_ich_nicht"/>

    <Field seq="Q22"  label="Wurden Sie auf der Intensivstation behandelt?"
           placeholder="" transportLocation="INV/Group[@Name='Krankheitsverlauf']/Field[@Name='Intensivstation_behandelt']"
           note="Ja / Nein / Weiss_ich_nicht"/>

    <Field seq="Q23"  label="Wurden Sie in den letzten 6 Monaten gegen Influenza geimpft?"
           placeholder="" transportLocation="INV/Group[@Name='Krankheitsverlauf']/Field[@Name='Influenza_Impfung_letzte_6_Monate']"
           note="Ja (+ Datum + Impfstoff) / Nein"/>

  </Section>

  <!-- ═══════════════════════════════════════════════════════════════════
       Section 3 — Angaben zum Infektionsweg
       All fields stored in INV/Group[@Name='Infektionsweg'].
  ═══════════════════════════════════════════════════════════════════════ -->
  <Section name="Angaben zum Infektionsweg">

    <Field seq="Q24"
           label="Kontakt mit Familienangehörigen mit ähnlichen Symptomen (1-2 Tage vor Erkrankung)?"
           placeholder="" transportLocation="INV/Group[@Name='Infektionsweg']/Field[@Name='Kontakt_Familie_aehnliche_Symptome']"
           note="Ja / Nein / Weiss_ich_nicht"/>

    <Field seq="Q25"
           label="Kontakt mit Arbeitskollegen / Freunden mit ähnlichen Symptomen?"
           placeholder="" transportLocation="INV/Group[@Name='Infektionsweg']/Field[@Name='Kontakt_Arbeitskollegen_Symptome']"
           note="Ja / Nein / Weiss_ich_nicht"/>

    <Field seq="Q26"
           label="Eine Reise unternommen?"
           placeholder="" transportLocation="INV/Group[@Name='Infektionsweg']/Field[@Name='Reise_unternommen']  + Field[@Name='Reiseziel']"
           note="Ja (+ Reiseangaben) / Nein; destination stored in separate Field"/>

    <Field seq="Q27"
           label="Direkten Kontakt zu Tieren (Geflügel, Wildvögel, Schweine)?"
           placeholder="" transportLocation="INV/Group[@Name='Infektionsweg']/Field[@Name='Direkter_Tierkontakt']  + Field[@Name='Tierkontakt_Datum']"
           note="Ja (+ Datum/Details) / Nein / Weiss_ich_nicht; date stored in separate Field"/>

  </Section>

</QuestionnaireTemplate>
